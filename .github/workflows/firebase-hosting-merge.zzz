# This file was auto-generated by the Firebase CLI
# https://github.com/firebase/firebase-tools

name: Deploy to Firebase Hosting on merge
on:
  push:
    branches:
      - originMaster2
jobs:
  build_and_deploy:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4

      - name: Use production firebase.json
        run: cp firebase.prod.json firebase.json

      - name: Copy to Dockerfile
        run: cp Deployfile Dockerfile

      - name: Copy to vite.congig
        run: cp deploy.js vite.config.mjs

      - name: Copy to Docker-compose
        run: cp deploy.yml docker-compose.yml

      - run: npm ci && npm run build
      - uses: FirebaseExtended/action-hosting-deploy@v0
        with:
          repoToken: ${{ secrets.GITHUB_TOKEN }}
          firebaseServiceAccount: ${{ secrets.FIREBASE_SERVICE_ACCOUNT_REMINDER5_27EF0 }}
          channelId: live
          projectId: reminder5-27ef0
