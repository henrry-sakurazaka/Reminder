{
  "hosting": {
    "public": "build",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "apiTodoList"
      },
      {
        "source": "/firebase-messaging-sw.js",
        "destination": "/firebase-messaging-sw.js"
      },
      {
        "source": "/__/auth/**",
        "destination": "/__/auth/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"  
  },
  "emulators": {
  "hosting": {
    "port": 5000
  },
  "pubsub": {
    "port": 5020
  },
  "functions": {
    "port": 5001
  },
  "firestore": {
    "port": 8080  
  },
  "auth": {
    "port": 9099
  },
  "storage": {
    "port": 9199
  }
},

  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
